# ~/.inputrc - Readline configuration for Bash
# Fast, responsive, case-insensitive completions with cycle menus

# Case-insensitive tab completion
set completion-ignore-case on

# Show all completions immediately when ambiguous
set show-all-if-ambiguous on
set show-all-if-unmodified on

# Cycle through completions on Tab (Zsh-like behavior)
TAB: menu-complete
"\e[Z": menu-complete-backward

# Highlight common prefix before cycling
set menu-complete-display-prefix on

# Colorized completions and file types
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on

# History search using Up/Down arrow keys based on what has already been typed
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward

# Disable audible/visual bell
set bell-style none
